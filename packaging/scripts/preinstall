#!/bin/sh
# Stop the running copies so their files can be replaced, and wait until launchd has really let go of the
# service (otherwise the postinstall's bootstrap can race the old copy). macwifid removes its network service
# and interfaces when it stops.
L=io.github.fpm8588.macwifid
user=$(stat -f %Su /dev/console 2>/dev/null)
if [ -n "$user" ] && [ "$user" != "root" ]; then
    launchctl bootout "gui/$(id -u "$user")/io.github.fpm8588.macwifi.menu" 2>/dev/null || true
fi
launchctl bootout "system/$L" 2>/dev/null || true
i=0
while launchctl print "system/$L" >/dev/null 2>&1 && [ $i -lt 30 ]; do sleep 1; i=$((i + 1)); done
pkill -x MacWifi 2>/dev/null || true
exit 0
