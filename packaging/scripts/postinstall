#!/bin/sh
# Start the background service, put macwifictl on the PATH, and start the menu bar app for the logged-in user.
# Loading is retried: launchd can still be tearing down the previous copy for a moment.
D="/Library/Application Support/macwifi"
L=io.github.fpm8588.macwifid
P=/Library/LaunchDaemons/$L.plist
chown -R root:wheel "$D"
chmod 755 "$D" "$D/macwifid" "$D/macwifictl" "$D/uninstall.sh" "$D/fetch-firmware.sh" "$D/report.sh"
# Release packages carry no firmware (AICsemi's, not open source): download it from the pinned Linux driver
# commits and check every SHA-256, as scripts/fetch-firmware.sh does in the repository.
if [ ! -f "$D/firmware/aic8800D80-legacy-mcu1/fmacfw_8800d80_u02.bin" ] || [ ! -f "$D/firmware/aic8800D80/fmacfw_8800d80_u02.bin" ]; then
    echo "Downloading the adapter firmware..."
    MW_FW_ROOT="$D" /bin/bash "$D/fetch-firmware.sh" >/dev/null 2>&1 ||
        echo "Couldn't download the firmware (offline?). Later run: sudo MW_FW_ROOT=\"$D\" \"$D/fetch-firmware.sh\"" >&2
    chown -R root:wheel "$D/firmware" 2>/dev/null
fi
touch /Library/Logs/macwifid.log && chmod 644 /Library/Logs/macwifid.log
mkdir -p /usr/local/bin && ln -sf "$D/macwifictl" /usr/local/bin/macwifictl
i=0
while [ $i -lt 10 ]; do
    if launchctl print "system/$L" >/dev/null 2>&1; then
        launchctl kickstart -k "system/$L" && break       # already loaded: restart it with the new binary
    elif launchctl bootstrap system "$P" 2>/dev/null; then
        break
    fi
    sleep 1
    i=$((i + 1))
done
launchctl print "system/$L" >/dev/null 2>&1 || echo "macwifid didn't start; run: sudo launchctl bootstrap system $P" >&2
user=$(stat -f %Su /dev/console 2>/dev/null)
if [ -n "$user" ] && [ "$user" != "root" ]; then
    uid=$(id -u "$user")
    launchctl bootstrap "gui/$uid" /Library/LaunchAgents/io.github.fpm8588.macwifi.menu.plist 2>/dev/null ||
        launchctl kickstart -k "gui/$uid/io.github.fpm8588.macwifi.menu" 2>/dev/null || true
fi
exit 0
