<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.fpm8588.macwifid</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/macwifi/macwifid</string>
        <string>daemon</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Library/Application Support/macwifi</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/Library/Logs/macwifid.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/macwifid.log</string>
</dict>
</plist>
